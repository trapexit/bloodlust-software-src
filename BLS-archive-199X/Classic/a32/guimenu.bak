int GUIhmenu::keyhit(char kbscan, char key)
{
 if (!key) return 0;
 return tmenu->keyhit(kbscan,key);
}

int menu::keyhit(char kbscan, char key)
{
 for (int i=0; m[i].text; i++)
  if (m[i].submenu && m[i].submenu->keyhit(kbscan,key)) return 1;
   else
  if (((m[i].key&0x80) && (m[i].key&0x7f)==kbscan) ||
      (!(m[i].key&0x80) && m[i].key==key))
            {m[i].menufunc(); return 1;}
 return 0;
}




//-----------------
GUIpopupmenu::GUIpopupmenu(GUIrect *treport,class menu *men,int x,int y)
 : GUIvmenu((GUImenu *)guiroot,men,x,y),report(treport)
 {
  //make sure we on screen
  if (x1<0) moverel(-x1,0);
  if (y1<0) moverel(0,-y1);
  if (x2>SCREENX) moverel(SCREENX-x2,0);
  if (y2>SCREENY) moverel(0,SCREENY-y2);
 // m.capture=this; //click(m);
  setmodal(this);
 }

GUIpopupmenu::~GUIpopupmenu()
 {
  setmodal(0);
 }
int GUIpopupmenu::domenuitem(menuitem *t)
{
 report->sendmessage(this,t-tmenu->m); //send menu number
 return 1;
}

int GUIpopupmenu::release(mouse &m)
{

 if (GUIvmenu::release(m)) ;
 delete this;
 return 1;
}

void GUIpopupmenu::draw(char *dest)
{
 GUIvmenu::draw(dest);
 outline(0);
}



