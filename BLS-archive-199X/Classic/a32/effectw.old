   if (m.x>x-xw/2 && m.x<x+xw/2 && m.y>y-yw/2 && m.y<y+yw/2)
     return this;
   return 0;
  }
 virtual int drag(mouse &m)
  {
    e->pos.x+=m.x-m.oldx;
    e->pos.y+=m.y-m.oldy;
    updatepos();
    return 1;
  };
 virtual int release(mouse &m) {return 1;}

 virtual char *getname() {return "e_blood edit";}
};



