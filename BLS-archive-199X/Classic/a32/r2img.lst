unsigned DecodeIFF(char *s,char *d,int bx,int by,int compression)
{
 int i,j,k;
 
 int wpl; //words per scan line per plane
 0898                    int unsigned near DecodeIFF( char near *, char near *, int, int, int ):
 0898  56                                push    esi
 0899  57                                push    edi
 089a  55                                push    ebp
 089b  83 ec 20                          sub     esp,00000020H
