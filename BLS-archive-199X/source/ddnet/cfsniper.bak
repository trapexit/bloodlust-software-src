//Enemy Control functions
#include <stdlib.h>
#include <string.h>

#include "glib.h"
#include "motion.h"
#include "input.h"
#include "smix.h"

#include "effect.h"
#include "object.h"

#include "misc.h"

//get series
#include "\a32\sniper.sdf"

int object::enemy_sniper(int instat)
 {
  move(fptr->dx,fptr->dy,fptr->dz);
  if (!in) return -1;

  if (instat&ID_LEFT) flip();

  if (instat&ID_BUT1) return pose1;

  if (instat&ID_BUT0)
   {
    if (instat&ID_UP)
     if (instat&ID_RIGHT) return stance_FUR;
         else return stance_FU;
    if (instat&ID_DOWN)
     if (instat&ID_RIGHT) return stance_FDR;
       else return stance_FD;
    return stance_FR;
   }
  return -1;
 }












