                .486
                .MODEL  flat
                LOCALS

                .DATA
                EXTRN _PITCH:DWORD,_SCREENX:DWORD,_SCREENY:DWORD

YLINE           dd ?
COUNT dw ?

                .CODE
                PUBLIC  _DrawImage,_ColorMapImage


;*********************************************************
;       Purpose:
;               Puts an image on the screen in mode 13h.
;       Call:
;               esi=Address of image
;               edi=Destination Address
;               bx=LSW
;               dl=XYb orient
;       Returns:
;               None
;       Destroyed:
;               ax,bx,cx,dx,si,di
;*********************************************************


_PutImageFlip256        PROC NEAR
        ARG @@SRC:DWORD,@@DEST:DWORD,@@LSW:DWORD,@@O:DWORD
          ;ret
                push    ebp
                mov     ebp,esp
;                push    ebx
;                push    esi
;                push    edi

                xor     eax,eax

                mov     esi,@@SRC
                mov     edi,@@DEST

                inc     esi
                lodsw
                mov     ecx,eax         ;Copy X,Y
                inc     esi

;               mov [@@O],0
                test    [@@O], 1b          ;Test Y Orientation
                jz      @@TYO
                movzx  eax,ch
                mul    @@LSW
                add    edi,eax           ;Move dest down ylines
                neg    [@@LSW]                         ;flip direction
@@TYO:
                movzx   eax,ch
                add     esi,eax
                add     esi,eax
;               movzx esi,word ptr [esi]
;               add     esi,@@SRC

                test    [@@O],10b       ;Test X orientation
                jz      BMON
                jmp     BMONFLIPX

_PutImageFlip256        ENDP

;****************************************************************
;********************** BMask ON *******************************
;****************************************************************

BMON            PROC             NEAR
        ARG @@SRC:DWORD,@@DEST:DWORD,@@LSW:DWORD,@@O:DWORD

                mov     edx,ecx         ;Y,X

                movzx   ecx,cl
                mov     ebx,ecx
                sub     @@LSW,ecx               ; DISKIP - X
                xor     eax,eax


@@VLOOP:        lodsb
                test    al,80h
                jnz     @@TCOLOR


                ;Data run
@@DCOLOR:
                sub     ebx,eax         ;decrement x counter

    ;;forwards memory copy!-------------------------------
                mov   ecx,edi
                neg   ecx
					 and     ecx, 3
                sub     eax, ecx
                jle     short @@LEndBytes
               rep movsb
                mov     ecx, eax
                and     eax, 3
                shr     ecx, 2
               rep movsd
@@LEndBytes:    add     ecx, eax
				   rep movsb
   ;;----------------------------------------------------
               xor eax,eax


                and     ebx,ebx
                jg     @@VLOOP
                jmp     @@DONELINE

                ;Transparent Run
@@TCOLOR:
                and     al,7Fh          ;mask off upper bits
                add     edi,eax
                sub     ebx,eax
                jg      @@VLOOP

@@DONELINE:
                movzx   ebx,dl
                add     edi,@@LSW
                dec     dh
                jnz     @@VLOOP

                pop     ebp
                ret
BMON            ENDP


;****************************************************************
;********************** BMask ON *******************************
;****************************************************************

BMONFLIPX       PROC          NEAR
        ARG @@SRC:DWORD,@@DEST:DWORD,@@LSW:DWORD,@@O:DWORD

                movzx   ebx,cl          ;X
                mov     edx,ecx         ;X => dl HVALUE  V
                add     @@LSW,ebx               ; DISKIP - X

                ;add     edi,ebx         ;;Go to right of scan line
                xor     eax,eax


@@VLOOP:        ;push  edi
                push  ebx

@@HLOOP:        lodsb
                test    al,80h
                jnz     @@TCOLOR


                ;Data run
@@DCOLOR:
                sub     ebx,eax         ;decrement x counter


;;;backwards memory copy! esi->~edi ecx=count
                mov     ecx,edi
					 and     ecx, 3
                sub     eax, ecx
                jle     short @@LEndBytes
              ; rep movsb
              jecxz @@NOC1
@@C1:         dec  edi
		        movsb
              dec  edi
              loop @@C1
@@NOC1:       mov     ecx, eax
                and     eax, 3
                shr     ecx, 2
               ;rep movsd
              jz @@LEndBytes
              push eax
              sub  edi,4
@@COPY:       lodsd
              bswap eax
              stosd
              sub edi,8
              loop @@COPY
              add edi,4
              pop eax
@@LEndBytes:    add     ecx, eax
				 ;  rep movsb
              jle @@DONEC3
@@C3:         dec  edi
		        movsb
              dec  edi
              loop @@C3
@@DONEC3:
;;memory copy------------------
               xor eax,eax

                and     ebx,ebx
                jg     @@HLOOP
                jmp     @@DONELINE

                ;Transparent Run
@@TCOLOR:       and     al,7Fh          ;mask off upper bits
                sub     edi,eax
                sub     ebx,eax
                jg      @@HLOOP

@@DONELINE:
                pop     ebx
                ;pop     edi
                add     edi,@@LSW

                dec     dh
                jnz     @@VLOOP


@@DONE:         pop     ebp
                ret
BMONFLIPX       ENDP


_PutImageFlipClip256 PROC   NEAR
        ARG @@SRC:DWORD,@@DEST:DWORD,@@LSW:DWORD,@@XSTART:DWORD,@@YSTART:DWORD,@@XTOTAL:DWORD,@@YTOTAL:DWORD,@@O:DWORD
                push    ebp
                mov     ebp,esp
                push    esi
                push    edi

                mov     esi,@@SRC
                mov   edi,@@DEST

                inc     esi
                lodsw
                movzx   ecx,ax          ;Copy X,Y
                inc     esi



                mov     bx,cx           ;Y,X
                xor     ch,ch
                xor     eax,eax

                test    @@O, 1b          ;Test Y Orientation
                jz      @@TYO
                ;redo YST and YT stuff
                mov   al,bh          ;ax=ylength
                sub     eax,@@YTOTAL ;YST=y-yt-yst
                sub     eax,@@YSTART
                mov     @@YSTART,eax

                push  edx
                mov     eax,@@YTOTAL          ;ax=ylength
                mul     @@LSW
                pop     edx

                add   edi,eax           ;Move dest down ylines
                neg     @@LSW
@@TYO:

                mov     eax,@@YSTART   ;;Point to address of first line
                lea    eax,[eax*2+esi]
                ;shl     eax,1
                ;add     eax,esi
                mov     [YLINE],eax


                test    @@O, 10b          ;Test X Orientation
                jz      @@TXO
                ;redo XST and XT stuff
                mov     eax,ecx          ;ax=xlength
                sub     eax,@@XTOTAL
                sub     eax,@@XSTART
                mov     @@XSTART,eax

                add     edi,@@XTOTAL            ;;Go to right of scan line
@@TXO:



                test    @@O,10b         ;Test X orientation
                jnz     @@FLIP
                call    BMCLIP
                jmp     @@DONE

@@FLIP:         call    BMCLIPFLIP


@@DONE:
                 pop    edi
                pop     esi
                pop     ebp
                ret
_PutImageFlipClip256 ENDP



BMCLIP          PROC       NEAR
        ARG @@SRC:DWORD,@@DEST:DWORD,@@LSW:DWORD,@@XSTART:DWORD,@@YSTART:DWORD,@@XTOTAL:DWORD,@@YTOTAL:DWORD,@@O:DWORD
                mov     edx,[@@XSTART]
                mov     ebx,[@@XTOTAL]


                xor     eax,eax
                xor     ecx,ecx


@@VLOOP:
                push    ebx
                push    edx
                push    edi

                mov     esi,[YLINE]
                movzx   esi,word ptr [esi]
                add     esi,@@SRC
                inc     [YLINE]
                inc     [YLINE]

                ;skip past xstart
                and     edx,edx
                jle     @@PHASE2


@@PHASE1:
                xor     eax,eax
                lodsb
                test    al,80h
                jnz     @@TCOLOR1
@@DCOLOR1:      add     esi,eax
                sub     edx,eax
                jg      @@PHASE1
                jz      @@PHASE2
                mov     eax,edx
                neg     eax
                sub     esi,eax
                jmp     @@DCOLOR2
@@TCOLOR1:      and     ax,7Fh
                sub     edx,eax
                jg      @@PHASE1
                jz      @@PHASE2
                mov     eax,edx
                neg     eax
                jmp     @@TCOLOR2


                ;------------------------------------
@@PHASE2:
                xor eax,eax
                        lodsb
                test    al,80h
                jnz     @@TCOLOR2

@@DCOLOR2:      sub     ebx,eax
                jge     @@NORIGHTCLIP
                add     eax,ebx
@@NORIGHTCLIP:
    ;;forwards memory copy!-------------------------------
                mov     ecx,eax
                sub     ecx,edi
                sub     ecx, eax
					 and     ecx, 3
                sub     eax, ecx
                jle     short @@LEndBytes
               rep movsb
                mov     ecx, eax
                and     eax, 3
                shr     ecx, 2
               rep movsd
@@LEndBytes:    add     ecx, eax
				   rep movsb
   ;;----------------------------------------------------
                and     ebx,ebx
                jg      @@PHASE2
                jmp     @@DONELINE

@@TCOLOR2:      and     eax,7fh
                add     edi,eax
                sub     ebx,eax
                jg      @@PHASE2

@@DONELINE:

                pop     edi
                add     edi,@@LSW

                pop     edx
                pop     ebx

                dec     [@@YTOTAL]      ;Decrease Y total
                jnz     @@VLOOP         ;


@@DONE:         ret
BMCLIP          ENDP







BMCLIPFLIP              PROC     NEAR
        ARG @@SRC:DWORD,@@DEST:DWORD,@@LSW:DWORD,@@XSTART:DWORD,@@YSTART:DWORD,@@XTOTAL:DWORD,@@YTOTAL:DWORD,@@O:DWORD


                mov     edx,[@@XSTART]
                mov     ebx,[@@XTOTAL]
                xor     eax,eax
                xor     ecx,ecx
;               add     di,bx   ;;Go to right of scan line


@@VLOOP:
                push    ebx
                push    edx
                push    edi

                mov     esi,[YLINE]
                movzx   esi,word ptr [esi]
                add     esi,@@SRC
                inc     [YLINE]
                inc     [YLINE]

                ;skip past xstart
                and     edx,edx
                jle     @@PHASE2

@@PHASE1:
                xor eax,eax
                lodsb
                test    al,80h
                jnz     @@TCOLOR1
@@DCOLOR1:      add     esi,eax
                sub     edx,eax
                jg      @@PHASE1
                jz      @@PHASE2
                mov     eax,edx
                neg     eax
                sub     esi,eax
                jmp     @@DCOLOR2
@@TCOLOR1:      and     ax,7Fh
                sub     edx,eax
                jg      @@PHASE1
                jz      @@PHASE2
                mov     eax,edx
                neg     eax
                jmp     @@TCOLOR2


                ;------------------------------------
@@PHASE2:
  xor eax,eax
        lodsb
                test    al,80h
                jnz     @@TCOLOR2

@@DCOLOR2:      sub     ebx,eax
                jge     @@NORIGHTCLIP
                add     eax,ebx
@@NORIGHTCLIP:




;;;backwards memory copy! esi->~edi ecx=count
                mov     ecx,edi
					 and     ecx, 3
                sub     eax, ecx
                jle     short @@LEndBytes
              ; rep movsb
              jecxz @@NOC1
@@C1:         dec  edi
		        movsb
              dec  edi
              loop @@C1
@@NOC1:       mov     ecx, eax
                and     eax, 3
                shr     ecx, 2
               ;rep movsd
              jz @@LEndBytes
              push eax
              sub  edi,4
@@COPY:       lodsd
              bswap eax
              stosd
              sub edi,8
              loop @@COPY
              add edi,4
              pop eax
@@LEndBytes:    add     ecx, eax
				 ;  rep movsb
              jle @@DONEC3
@@C3:         dec  edi
		        movsb
              dec  edi
              loop @@C3
@@DONEC3:
;;memory copy------------------

                and     ebx,ebx
                jg         @@PHASE2
                jmp     @@DONELINE


@@TCOLOR2:      and     eax,7fh
                sub     edi,eax
                sub     ebx,eax
                jg      @@PHASE2



@@DONELINE:     pop     edi
                add     edi,@@LSW

                pop     edx
                pop     ebx

                dec     [@@YTOTAL]      ;Decrease Y total
                jg      @@VLOOP         ;


@@DONE:         ret
BMCLIPFLIP      ENDP



;void DrawImage(char far *src,char far *dest,int x,int y,int o);
_DrawImage PROC     NEAR
        ARG     @@SRC:DWORD,@@DEST:DWORD,@@X:DWORD,@@Y:DWORD,@@O:DWORD
;       ret
        push    ebp
        mov     ebp,esp
        push ebx
        push    esi
        push  edi

        mov     esi,[@@SRC]
        mov     edi,[@@DEST]
        and     esi,esi
        jz      @@DONE

;        test    @@O,10b ;X-flipped
;        jz   @@NOXFLIP
;        movzx eax,BYTE PTR [esi+1]
;        sub @@X,eax
;@@NOXFLIP:

        xor     ecx,ecx ;cl=XST  ch=XLEN
        xor     edx,edx   ;dl=YST  dh=YLEN
        xor     ebx,ebx ;Clip flag
        mov     ch,[esi+1]
        mov     dh,[esi+2]

        cmp     [@@X],0
        jge     @@NOXL
        inc     bl
        sub     cl,[byte ptr @@X]  ;xst=0-x

        movzx   eax,ch
        add     eax,[@@X]           ;xt =xst+xl
        jle     @@DONE

        mov     [@@X],0
        mov     ch,al
@@NOXL:

        cmp     [@@Y],0
        jge     @@NOYL
        inc     bl
        sub     dl,[byte ptr @@Y]  ;yst=0-y

        movzx   eax,dh
        add     eax,[@@Y]           ;yt =yst+xl
        jle     @@DONE

        mov     [@@Y],0
        mov     dh,al
@@NOYL:

        movzx   eax,ch
        add     eax,@@X
        cmp     eax,_SCREENX
        jle     @@NOXR
        inc     bl

        mov     eax,_SCREENX
        sub     eax,[@@X]
        jle     @@DONE
        mov     ch,al
@@NOXR:

        movzx   eax,dh
        add     eax,@@Y
        cmp     eax,_SCREENY
        jle     @@NOYR
        inc     bl

        mov     eax,_SCREENY
        sub     eax, [@@Y]
        jle     @@DONE
        mov     dh,al
@@NOYR:

        push  edx
        mov     eax,@@Y
        mul     _PITCH
        add     eax,@@X
        add     edi,eax
        pop     edx


        and     bl,bl
        jnz     @@CLIP
        push    @@O
        push    _PITCH
        push    edi
        push    esi
        call    _PutImageFlip256
        add     esp,4*4
        jmp     @@DONE

@@CLIP:

        xor     eax,eax

        push    @@O
        mov     al,dh
        push    eax
        mov     al,ch
        push    eax
        mov     al,dl
        push    eax
        mov     al,cl
        push    eax
        push    _PITCH
        push    edi
        push    esi
        call    _PutImageFlipClip256
        add     esp,8*4

@@DONE:

        pop     edi
        pop     esi
        pop     ebx
        pop     ebp
        ret
_DrawImage ENDP




_ColorMapImage  PROC   NEAR
        ARG     @@IMG:DWORD,@@MAP:DWORD

                push    ebp
                mov     ebp,esp

                push ebx
                push    esi
                push    edi

                mov     esi,@@IMG
                mov     edi,@@MAP

                inc esi
                lodsw
                mov     dx,ax  ;dl-x  dh-y
                inc esi

                xor     eax,eax
                mov   al,dh
                add     esi,eax
                add     esi,eax


                xor     ecx,ecx
                xor     ebx,ebx

                mov     ah,dl

@@VLOOP:        lodsb
                test    al,80h
                jnz     @@TCOLOR


                ;Data run
@@DCOLOR:       sub     ah,al           ;decrement x counter
                movzx   cx,al


;               add     si,cx

@@CLOOP:        mov     bl,[esi]
                mov     al,[edi+ebx]
                mov     [esi],al
                inc     esi
                loop    @@CLOOP


@@DONELOOP:     and     ah,ah
                jnz     @@VLOOP
                jmp     @@DONELINE

                ;Transparent Run
@@TCOLOR:       and     al,7fh
                sub     ah,al
                jnz     @@VLOOP

@@DONELINE:     mov     ah,dl
                dec     dh
                jnz     @@VLOOP

                pop     edi
                pop     esi
                pop     ebx
                pop     ebp
                ret
_ColorMapImage  ENDP








                END
