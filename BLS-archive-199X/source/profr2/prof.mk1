 *wpp386 prof.cpp -i=C:\WATCOM\h -w2 -e25 -zq -otexan -ol -ol+ -om -oc -oi -&
oa -or -oe20 -5r -bt=dos -mf

c:\source\profr2\r2img.obj : c:\source\profr2\r2img.cpp .AUTODEPEND
 @c:
