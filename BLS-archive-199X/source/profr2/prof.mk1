-oa -or -oe20 -5r -bt=dos -mf

c:\source\profr2\vol.obj : c:\source\profr2\vol.cpp .AUTODEPEND
 @c:
 cd c:\source\profr2
 *wpp386 vol.cpp -i=C:\WATCOM\h -w2 -e25 -zq -otexan -ol -ol+ -om -oc -oi -o&
a -or -oe20 -5r -bt=dos -mf

c:\source\profr2\prof.exe : c:\source\profr2\r2imgasm.obj c:\source\profr2\f&
ile.obj c:\source\profr2\prof.obj c:\source\profr2\r2img.obj c:\source\profr&
2\vol.obj .AUTODEPEND
 @c:
 cd c:\source\profr2
 @%write prof.lk1 NAME prof
 @%append prof.lk1 FIL r2imgasm.obj,file.obj,prof.obj,r2img.obj,vol.obj
 @%append prof.lk1 
