!define BLANK ""
c:\source\profr2\r2imgasm.obj : c:\source\profr2\r2imgasm.asm .AUTODEPEND
 @c:
 cd c:\source\profr2
 *wasm r2imgasm.asm -i=C:\WATCOM\h -mf -5r -w4 -e25 -zq

c:\source\profr2\file.obj : c:\source\profr2\file.cpp .AUTODEPEND
 @c:
 cd c:\source\profr2
 *wpp386 file.cpp -i=C:\WATCOM\h -w2 -e25 -zq -otexan -ol -ol+ -om -oc -oi -&
oa -or -oe20 -5r -bt=dos -mf

c:\source\profr2\prof.obj : c:\source\profr2\prof.cpp .AUTODEPEND
 @c:
