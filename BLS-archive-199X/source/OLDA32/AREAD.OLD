extern int numodf;
extern objectdef *odf;


void ReadObjectNames(char *onf)
{
FILE *f;
f=fopen(onf,"rt");
if (!f) {printf("cannot open object definition file %s\n",onf); exit(1);}

char line[50];
//fgets(line,50,f); //get num objects
//sscanf(line,"%d",&numodf);
odf=(objectdef *)malloc(256*sizeof(objectdef));  //allocate memory for all odf
memset(odf,0,256*sizeof(objectdef));

numodf=0;

while (fgets(line,50,f)) //read line into memory
{
//   printf("%s\n",line);
static  char name[32],sdf[32],dir[32];
static  int otype;
  if (sscanf(line,"%d %s %s %s",&otype,name,sdf,dir)<4)
   break; //{printf("error in object list\n%s\n",line);  exit(1);}

  //set up objectdef
  odf[otype].otype=otype; //ordinal number of type
  strcpy(odf[otype].name,name);
  strcpy(odf[otype].sdf,sdf);
  strcpy(odf[otype].dir,dir);

  if (otype>numodf) numodf=otype;
} 
numodf++;

odf[0].otype=0;
odf[0].loaded=0;
strcpy(odf[0].name,"NULL");
odf[0].sdf[0]=odf[0].dir[0]=0;


//resize odf
odf=(objectdef *)realloc(odf,numodf*sizeof(objectdef)); 

fclose(f);
}



extern char cfuncnames[256][32];
extern int cfuncnum;

void ReadControlFuncs(char *cfile)
{
FILE *f;
f=fopen(cfile,"rt");
if (!f) {printf("cannot open control function definition file %s\n",cfile); exit(1);}

char line[100];
do
{
 fscanf(f,"%s",line); //scan each funcname
} while (line[0]!='{'); //scan till first {


for (int i=0; ; i++)
 {
  fscanf(f,"%s",line); //scan each funcname
  if (line[0]=='}') break; //done reading cfuncs
  *strchr(line,',')=0;
  strcpy(cfuncnames[i],strchr(line,':')+2);
//  printf("%d: %s\n",i,cfuncnames[i]);
 }

//getch(); 
cfuncnum=i; 

fclose(f);
}





int ReadRawFile(char **m,int h)
{
unsigned bytes;    
char header[4];
_dos_read(h,header,4,&bytes);
int x=(int)header[1];
int y=(int)header[2];

int size=y*2+filelength(h);

char *t=(char *)malloc(size);
if (!t)
{
 strcpy(errstr,"out of memory readrawfile\n");
 cleanexit(1);
}

for (int i=0;i<4;i++) t[i]=header[i];
short *ylist=(short *) (t+4);
char *img=t+4+ y*2;

_dos_read(h,img,size-y*2-4,&bytes);
for (i=0; i<y; i++)
{
ylist[i]=(short )(img-t);

int xl=x;
while (xl>0)
 {
  if ( (*img)&0x80) {xl-=(*img)&0x7f; img++;}
         else            {xl-=*img; img+=*img; img++; }
 }
}
*m=t;
return(size);
}


int memused;

//read list of image files
int ReadImageList(char *list,imagedef **imagedefs)
{

 //allocate memory for all of idf
 int numidf=0;
 imagedef *idf=(imagedef *)malloc(256*sizeof(imagedef));
 if (!idf) exit(1);
 memset(idf,0,256*sizeof(imagedef));

 //open image definition file
 FILE *f;
 f=fopen(list,"rt");
 
 if (f)  //read the idf file (if it exists)
 {
  char line[50];
  fgets(line,50,f); //get maximum number of images
  sscanf(line,"%d",&numidf);

  for (int i=0; i<numidf; i++) //read all images
   if (fgets(line,50,f)) //read line into memory
   {
    int num; char name[12];
    if (sscanf(line,"%d %s",&num,name)==2)
     {
      strcpy(idf[num].name,name); //copy name
      if (num>numidf) numidf=num;
     } 
    } else {numidf=i; break;}
   fclose(f); 
  }


 //get lots of imagedefs
 int h;
 find_t   ft;
 int done=_dos_findfirst("*.raw",0,&ft);
 while (!done)
 {
  //get name of file without extension
  char fname[20]; 
  for (int j=0; ft.name[j] && ft.name[j]!='.' && j<8; j++) fname[j]=ft.name[j];
  fname[j]=0; 

  for (j=0; j<numidf; j++) //search list
   if (!stricmp(idf[j].name,fname)) break; //see if we can find it...

  if (j==numidf) //was not found in list
    {
     strcpy(idf[j].name,fname); //make new id
     numidf++;  //added new file
     if (numidf==255) {sprintf(errstr,"too many images\n"); cleanexit(-1);}
    } 
     
  //Read file
  _dos_open(ft.name,O_BINARY | O_RDONLY,&h);
  memused+=ReadRawFile((char **)&idf[j].ptr,h);   //read image file
  _dos_close(h);

  //draw it
  DrawImage(idf[j].ptr,(char *)0xA0000,0,0,0);

  done=_dos_findnext(&ft);
 }

 //write files to list
 f=fopen(list,"wt");
 fprintf(f,"%d\n",numidf); //number
 for (int i=0; i<numidf; i++)
  if (idf[i].name[0]) fprintf(f,"%d %s\n",i,idf[i].name);
 fclose(f);

 //return
// idf=(imagedef *)realloc((char *)idf,numidf*sizeof(imagedef));
 *imagedefs=idf;   //store pointer to image defs
 return(numidf);  //return idf
}    


//read list of Sound files
int ReadSoundList(char *list,sounddef **sounddefs)
{

 //allocate memory for all of sounds
 int numsounds=0;
 sounddef *s=(sounddef *)malloc(32*sizeof(sounddef));
 if (!s) exit(1);
 memset(s,0,32*sizeof(sounddef));

 //open image definition file
 FILE *f;
 f=fopen(list,"rt");
 
 if (f)  //read the sound file (if it exists)
 {
  char line[50];
  fgets(line,50,f); //get maximum number of images
  sscanf(line,"%d",&numsounds);

  for (int i=0; i<numsounds; i++) //read all images
   if (fgets(line,50,f)) //read line into memory
   {
    int num; char name[12];
    if (sscanf(line,"%d %s",&num,name)==2)
     {
      strcpy(s[num].name,name); //copy name
      if (num>numsounds) numsounds=num;
     } 
    } else {numsounds=i; break;}
   fclose(f); 
  }


 //get lots of sounddefs
 find_t   ft;
 int done=_dos_findfirst("*.wav",0,&ft);
 while (!done)
 {
  //get name of file without extension
  char fname[20]; 
  for (int j=0; ft.name[j] && ft.name[j]!='.' && j<8; j++) fname[j]=ft.name[j];
  fname[j]=0; 

  for (j=0; j<numsounds; j++) //search list
   if (!stricmp(s[j].name,fname)) break; //see if we can find it...

  if (j==numsounds) //was not found in list
    {
     strcpy(s[j].name,fname); //make new id
     numsounds++;  //added new file
     if (numsounds==31) {sprintf(errstr,"too many sounds\n"); cleanexit(-1);}
    } 
     
  //Read file
  s[j].ptr=ReadWavFile(ft.name);
  memused+=s[j].ptr->soundsize;

  done=_dos_findnext(&ft);
 }

 //write files to list
 f=fopen(list,"wt");
 fprintf(f,"%d\n",numsounds); //number
 for (int i=0; i<numsounds; i++)
  if (s[i].ptr) fprintf(f,"%d %s\n",i,s[i].name);
 fclose(f);

 //return
// idf=(imagedef *)realloc((char *)idf,numidf*sizeof(imagedef));
 *sounddefs=s;   //store pointer to image defs
 return(numsounds);  //return idf
}    


//save series list to file
void objectdef::SaveSeriesList()
{

 unsigned bytes;
 int h;
 _dos_creat("series.lst",0,&h);

 int sig=0x6969;
 _dos_write(h,&sig,4,&bytes); //write sig
 
 _dos_write(h,&nums,4,&bytes); //number of series
 int seriessize=sizeof(series);
 _dos_write(h,&seriessize,4,&bytes); //size of each series
 
 _dos_write(h,sd,nums*sizeof(series),&bytes); //write all serieses

 //write all the frames for each series
 for (int i=0; i<nums; i++)
  _dos_write(h,sd[i].first,sd[i].size,&bytes);

 mprintf("%s saved: %d series %d bytes",name,nums,filelength(h));
 _dos_close(h);

 dirty=0;
}    

int objectdef::LoadSeriesList()
{
 unsigned bytes;
 int h;

//ModeText();
//--------------------------------
//read standard series definition
//------------------------------
 FILE *f=fopen(sdf,"rt");
 if (!f) {mprintf("cannot open series definition file %s",sdf);  return -1;}
      
 char line[50];
 nums=-1;
 sd=(series *)malloc(256*sizeof(series));  //allocate memory for all seriess
 memset(sd,0,256*sizeof(series)); //clear series
 while (fgets(line,50,f))
  {
   int i; char n[50],d[50];
   if (sscanf(line,"%s %s %d",d,n,&i)==3 && !stricmp(d,"#define"))
    {
     strcpy(sd[i].name,n);
     if (i>nums) nums=i;
    }

  }
nums++;
fclose(f);
sd=(series *)realloc(sd,nums*sizeof(series));


//-----------------------------------------
//read saved series definitions for the object
//--------------------------------------

int tread=0;
  //read existing list
if (!_dos_open("series.lst",O_BINARY | O_RDONLY,&h))
 {  
     //read signiture
   unsigned int sig;     
   int tnums;
   series *t;
   int seriessize;

   _dos_read(h,&sig,4,&bytes);
   if (sig!=0x6969) //if sig not present, old series file
     {
      tnums=sig; //assume tnums=sig then
      seriessize=41; //old series size
     } else //sig present
     {
      _dos_read(h,&tnums,4,&bytes);
      _dos_read(h,&seriessize,4,&bytes);      
     }


   t=(series *)malloc(tnums*sizeof(series));
   for (int a=0; a<tnums; a++) //read all series defs
     _dos_read(h,&t[a],seriessize,&bytes); //read all of stored series definitions
   
    
     int i,j;
   //go through each saved series
   for (i=0; i<tnums; i++)
   {
    t[i].cf=0;
    //read the frames of the series into memory
    if (t[i].size)
      {
       t[i].first=(frame *)malloc(t[i].size);     //get memory
       _dos_read(h,t[i].first,t[i].size,&bytes);
       tread++;
      }
    
    //find the series character name in the SDF
    for (j=0; j<nums; j++)
         if (!stricmp(t[i].name,sd[j].name)) break; //find series

    //we found a matching series name
    if (j<nums)
      { sd[j]=t[i]; }//copy series to final list that has the same name
     else
    if (i<nums && !sd[i].first)
     {
      if (!t[i].size) strcpy(t[i].name,sd[i].name);
      sd[i]=t[i]; //if cooresponding empty numeral series exists...copy it over
     }
     else
    if (t[i].first) free(t[i].first); //if no numeral or character cooresponding one exists, free it
   }
   
   free(t);
   _dos_close(h);
  }


return tread; 
}    



//save motion def list to file
void objectdef::SaveMotionDefList()
{
 unsigned bytes;
 int h;
 _dos_creat("motion.lst",0,&h);

 int sig=0x9958;
 _dos_write(h,&sig,4,&bytes); //write sig
 
 _dos_write(h,&nummotions,4,&bytes); //number of motion defs
 int motionsize=sizeof(motiondef);
 _dos_write(h,&motionsize,4,&bytes); //size of each motion def
 
 _dos_write(h,md,nummotions*motionsize,&bytes); //write all motions def
 _dos_close(h);


}    


//load motion list from file
int objectdef::LoadMotionDefList()
{
 unsigned bytes;
 int h;
//no file, no motions
 if (_dos_open("motion.lst",O_BINARY|O_RDONLY,&h)) return 0;

 int sig;
 _dos_read(h,&sig,4,&bytes); //read sig
 if (sig!=0x9958) {_dos_close(h); return 0;}
 
 
 _dos_read(h,&nummotions,4,&bytes); //number of motion defs
 int motionsize; 
 _dos_read(h,&motionsize,4,&bytes); //size of each motion def

 md=0;
 if (nummotions)
 {
  md=(motiondef *)malloc(nummotions*sizeof(motiondef));
 _dos_read(h,md,nummotions*sizeof(motiondef),&bytes); //read all motion defs
 } 
 _dos_close(h);

 return nummotions;
}    
      
