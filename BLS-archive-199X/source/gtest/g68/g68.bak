 OUT("rcl ch,1");
}


//instruction parameters
struct iparm
{
 word op;
 int dsize; //data size (0=b 1=w 2=l 3=???)

 int amode; //addr (lower 6-bit, bottom 3 usually variable)
 int dmode; //destination addr (fixed)

 int n; //register num (variable)
 int m; //register num (fixed)

 int c; //condition 4-bit fixed

 //sets parameters based on opcode and insttype
 void set(word opcode,struct insttype *it);

 int validate(word opcode,word mask)
 {
  if ((op&mask)!=opcode) return 0;
  if (dsize>2) return 0;
  if (amode>0x3B) return 0;
  if (dmode>0x3B) return 0;
  return 1;
 }

 void print()
 {
  printf("%s am=%d dm=%d\n",dsize!=-1 ? isize[dsize] : "",amode,dmode);
 }
};


void genread(int t,int dsize)
{
 switch (t)
 {
  case DIRECTI: printf("\tmov %s,[edx] ;read\n",areg[dsize]); return;
  case DIRECTM:
   printf("\tmov %s,[edx] ;read\n",areg[dsize]);
   bswap('a',dsize);
   return;
  case TRAP: printf("\tcall g68read%c ;read\n",zchar[dsize]); return;
  case IMMEDIATE: return;
 }
}

void genwrite(int t,int dsize)
{
 switch (t)
 {
  case DIRECTI: printf("\tmov [edx],%s ;write\n",areg[dsize]);  break;
  case DIRECTM:
   bswap('a',dsize);
   printf("\tmov [edx],%s ;write\n",areg[dsize]);
   break;
  case TRAP: printf("\tcall g68write%c ;write\n",zchar[dsize]); break;
  case IMMEDIATE: return;
 }
}


//pushes reg (overwrites edx)
void pushd(char *reg)
{
 OUT("sub [edi.A7],4 ; dec stackptr");
 OUT("getstackptr edx");
 printf("\tbswap %s\n",reg);
 printf("\tmov [edx],%s\n",reg);
}

//pops reg (overwrites edx)
void popd(char *reg)
{
 OUT("getstackptr edx");
 OUT("add [edi.A7],4 ; add stackptr");
 printf("\tmov %s,[edx]\n",reg);
 printf("\tbswap %s\n",reg);
}


