//fetches immediate data
int genfetchimm(int immtype,int dsize)
{
 int immsize=0;
 switch (immtype)
 {
  case IMM_NONE: return 0;
  case IMM_BYTE: dsize=0; break;
  case IMM_WORD: dsize=1; break;
  case IMM_LONG: dsize=2; break;
 };

// printf(";%d\n",dsize);
 switch(dsize)
 {
  case 0:
   printf("\tmov bl,[esi+1]\n");  immsize=2;
   printf("\tadd esi,%d\n",immsize);
   break;
  case 1:
   printf("\tmov bx,[esi]\n"); immsize=2;
   printf("\tadd esi,%d\n",immsize);
   bswap('b',dsize);
   break;
  case 2:
   printf("\tmov ebx,[esi]\n"); immsize=4;
   printf("\tadd esi,%d\n",immsize);
   bswap('b',dsize);
   break;
   }
 return immsize;
}



void genlea(int amode,int dsize)
{
 switch (amode)
  {
   case 0x00: printf("\tlea000\n"); break;
   case 0x08: printf("\tlea001\n"); break;

   case 0x10: printf("\tlea010\n"); break;
   case 0x18: printf("\tlea011%c\n",zchar[dsize]); break;
   case 0x20: printf("\tlea100%c\n",zchar[dsize]); break;

   case 0x1F: //(A7)+
    if (dsize==0) printf("\tlea011111b\n");
         else     printf("\tlea011%c\n",zchar[dsize]);
     break;

   case 0x27: //(A7)-
    if (dsize==0) printf("\tlea100111b\n");
         else     printf("\tlea100%c\n",zchar[dsize]);
     break;


   case 0x28: printf("\tlea101\n"); break;
   case 0x30: printf("\tlea110\n"); break;
   case 0x38: printf("\tlea111000\n"); break;
   case 0x39: printf("\tlea111001\n"); break;
   case 0x3A: printf("\tlea111010\n"); break;
   case 0x3B: printf("\tlea111011\n"); break;
   case 0x3C: printf("\tlea111100%c\n",zchar[dsize]); break;
  };
}


void registerproc(char *name,word opcode,int var);

//instruction type
struct insttype
{
 char *format;    //binary format
 char *name;      //name of instruction
 int addrmode;    //address modes
 int immtype;
 int naturalize; //naturalize address before core ?

 //gets the mask from the format (1 for every constant digit)
 word getmask();
 //get opcode from the format ?'s=000's
 word getopcode();
 //gets ??? from format
 int getx(word opcode,char x);
 //does x exist in format?
 int isx(char x) {return strchr(format,x) ? 1 : 0;}
 //finds the last field
 int getlastx(char &c);

 //constructor
 insttype(char *f,char *n,int am):
  format(f),name(n),addrmode(am),immtype(0),naturalize(1) {}

 void printinfo()
 {
  printf("%10s %s\n",name,format);
  if (!addrmode) return;
  printf("     ");
  for (int i=0; i<16; i++)
   if (addrmode&(1<<i)) //does addr mode exists?
     {printf(addrname[i]); printf(" ");}
  printf("\n");
 }

 //core header
 void gencorehdr(int t,iparm &ip)
 {
  static char *ft[4]={"_di","_dm","_trap",""};
  printf(";%s xxxx\n",name);
  printf("core%04X%s%s proc\n",ip.op,immname[immtype],ft[t]);
 }
 //core footer
 void gencoreftr(int t,iparm &ip)
 {
  printf("\texecutenext\n");
  printf("      endp\n\n");
 }

 //generate core of instruction
 virtual void gencore(int t,iparm &ip) {}

 virtual void gencoreproc(int t,iparm &ip)
 {
  if (ip.dsize==-1) ip.dsize=2;
  gencorehdr(t,ip);
  gencore(t,ip);
  gencoreftr(t,ip);
 };

 void genstubproc(iparm &ip)
 {
  char stubname[32];
  sprintf(stubname,"i%04X%s",ip.op,immname[immtype]);

  if (ip.amode==-1)
  {
   char c;
   registerproc(stubname,ip.op,1<<getlastx(c));
   printf("%s proc\n",stubname);
   genfetchimm(immtype,ip.dsize);
   printf("      endp\n\n");
   return;
  }
  if (ip.amode>0x3C) return;

  if (ip.amode>=0x38 || (ip.amode&7)) registerproc(stubname,ip.op,1);
               else   registerproc(stubname,ip.op,8);

  printf("%s proc\n",stubname);
  genfetchimm(immtype,ip.dsize);

  genlea(ip.amode,ip.dsize);

  char corename[32];
  sprintf(corename,"core%04X%s",ip.op&(~0x3F),immname[immtype]);

  if (ip.amode==0x3C) printf("\tjmp %s_dm\n",corename);
   else
  if (ip.amode<=0x08 || !naturalize) printf("\tjmp %s_di\n",corename);
   else printf("\tnaturalize %s,%s_dm,%s_trap\n","edx",corename,corename);
  printf("      endp\n\n");

  //byte and a+/- addr mode?
  if (ip.dsize==0 && (ip.amode==0x18 || ip.amode==0x20))
   {
    ip.amode|=7;
    ip.op|=7;
    genstubproc(ip);
   }
 }

 void generate()
 {
  iparm ip;
  word minopcode=getopcode();
  word mask=getmask();
  word maxopcode=minopcode|(~mask);

  char lastc;
  word opcodestep=getlastx(lastc);
  opcodestep=1<<opcodestep;
//  printf(";%X %X %X %c\n",minopcode,maxopcode,opcodestep, lastc);

  word opcode=minopcode;

  do
  {
  ip.set(opcode,this);
  if (ip.validate(minopcode,mask))
  {
   printf(";----------------------------\n");
   printf(";    %s ",name); ip.print();
   printf(";----------------------------\n\n");

   if (!addrmode)
   {
    genstubproc(ip);
    gencoreproc(IMMEDIATE,ip);
   }
    else
   {
    //generate cores
    if (addrmode&(Dn|An) || !naturalize) gencoreproc(DIRECTI,ip);
    if ((addrmode&(iAn|iAni|idAn|d16An|d8AnR|addr16|addr32|d16PC|d8PCR))
      && naturalize)
     {
      gencoreproc(DIRECTM,ip);
      gencoreproc(TRAP,ip);
     }

    //generate addressing modes
    for (int i=0; i<16; i++)
     if (addrmode&(1<<i)) //does addr mode exists?
      {
       ip.op=opcode|addrbits[i];
       ip.amode=addrbits[i];
       genstubproc(ip);
      }
   }
  }
  opcode+=opcodestep;
  } while (opcode<=maxopcode);

 };

};


//---------------------------------
//bit/format manipulation

word insttype::getmask()
{
 word m=0,bit=0x8000;
 for (char *s=format; *s; s++)
 {
  if (isdigit(*s)) m|=bit;
  if (isalnum(*s)) bit>>=1;
 }
 return m;
}

word insttype::getopcode()
{
 word m=0,bit=0x8000;
 for (char *s=format; *s; s++)
 {
  if (isdigit(*s) && *s=='1') m|=bit;
  if (isalnum(*s)) bit>>=1;
 }
 return m;
}

int insttype::getx(word op,char x)
{
 word m=0,bit=0x8000;
 char *s=format;
 for (; *s && *s!=x; s++) if (isalnum(*s)) bit>>=1;
 if (!*s) return -1; //'x' does not exist
 for (; *s && *s==x; s++)
 {
  m<<=1;
  if (op&bit) m|=1;
  bit>>=1;
 }
 return m;
}

int insttype::getlastx(char &c)
 {
  for (int i=0; format[i]; i++);

  c=format[--i];
  if (!isalpha(c)) return 0;

  int len=0;
  while (i>0 && !isdigit(format[i]) )
    if (format[i--]==c) len++;
  return len;
 }


//sets parameters based on opcode and insttype
void iparm::set(word opcode,struct insttype *it)
 {
  op=opcode;
  amode=it->getx(opcode,'a');
  dmode=it->getx(opcode,'d');
  if (dmode!=-1)
    dmode=((dmode&7)<<3) | ((dmode>>3)&7); //reverse

  n=it->getx(opcode,'n');
  m=it->getx(opcode,'m');

  c=it->getx(opcode,'c');

  if (it->isx('z')) dsize=it->getx(opcode,'z'); else
  if (it->isx('y')) dsize=it->getx(opcode,'y')+1; else
  if (it->isx('v'))
   {
    int l=it->getx(opcode,'v');
    dsize=3;
    if (l==1) dsize=0;
    if (l==2) dsize=2;
    if (l==3) dsize=1;
   } else dsize=-1;
 }



