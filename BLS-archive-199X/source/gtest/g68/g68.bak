FILE *pf;

int instreg=0;
int diag=0;

void createflagtables();

int main(int argc,char *arg[])
{
 if (argc>=2 && !stricmp(arg[1],"diag")) diag=1;
 int i;

 createflagtables();

 if (diag)
 {
  for (i=0; it[i]; i++) it[i]->printinfo();
  return 0;
 }

 pf=fopen("g68pjt.inc","wt");

 //generate all instruction types
 for (i=0; it[i]; i++) it[i]->generate();

 fclose(pf);
}

void registerproc(char *name,word op,int var)
{
 if (!var) return;
 fprintf(pf,"dd offset %s\n",name);
 fprintf(pf,"dw 0%04Xh\n",op);
 fprintf(pf,"db %d\n",var-1);
// for (int i=0; i<var; i++) jtable[op+i]=op;
 instreg++;
};



//-----------------------------


#define G68FLAG_C 1
#define G68FLAG_V 2
#define G68FLAG_Z 4
#define G68FLAG_N 8
#define G68FLAG_X 16

#define IFLAG_C 0x0001
#define IFLAG_Z 0x0040
#define IFLAG_N 0x0080
#define IFLAG_V 0x0800


void createflagtables()
{
 int i;
 FILE *f;

 f=fopen("g68fi2m.inc","wt");
 //create intel->motorola
 for (i=0; i<256; i++)
 {
  byte x=0;
  if (i&IFLAG_C) x|=G68FLAG_C;
  if (i&IFLAG_Z) x|=G68FLAG_Z;
  if (i&IFLAG_N) x|=G68FLAG_N;
  fprintf(f,"db %03Xh\n",x);
 }
 fclose(f);

 f=fopen("g68fm2i.inc","wt");
 //create motorola->intel
 for (i=0; i<256; i++)
 {
  byte x=0;
  if (i&G68FLAG_C) x|=IFLAG_C;
  if (i&G68FLAG_Z) x|=IFLAG_Z;
  if (i&G68FLAG_N) x|=IFLAG_N;
  fprintf(f,"db %03Xh\n",x);
 }
 fclose(f);
}

















