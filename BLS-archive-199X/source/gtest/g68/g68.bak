//gets register as defined in EAX
void getreg(char *r)
{printf("\tmov %s,[edi.D0+eax*4]\n",r);}
void setreg(char *r)
{printf("\tmov [edi.D0+eax*4],%s\n",r);}

void getareg(char *r)
{printf("\tmov %s,[edi.A0+eax*4]\n",r);}
void setareg(char *r)
{printf("\tmov [edi.A0+eax*4],%s\n",r);}


