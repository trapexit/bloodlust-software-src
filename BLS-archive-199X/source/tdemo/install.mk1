!define BLANK ""
c:\source\tdemo\cdasm.obj : c:\source\tdemo\cdasm.asm .AUTODEPEND
 @c:
 cd c:\source\tdemo
 *wasm cdasm.asm -i=C:\WATCOM\h -mf -5r -w4 -e25 -zq

c:\source\tdemo\doserr.obj : c:\source\tdemo\doserr.asm .AUTODEPEND
 @c:
 cd c:\source\tdemo
 *wasm doserr.asm -i=C:\WATCOM\h -mf -5r -w4 -e25 -zq

c:\source\tdemo\cdrom.obj : c:\source\tdemo\cdrom.cpp .AUTODEPEND
 @c:
 cd c:\source\tdemo
 *wpp386 cdrom.cpp -i=C:\WATCOM\h -w2 -e25 -zq -otexan -d2 -5r -bt=dos -mf

c:\source\tdemo\install.obj : c:\source\tdemo\install.cpp .AUTODEPEND
 @c:
 cd c:\source\tdemo
 *wpp386 install.cpp -i=C:\WATCOM\h -w2 -e25 -zq -otexan -d2 -5r -bt=dos -mf

c:\source\tdemo\install.exe : c:\source\tdemo\cdasm.obj c:\source\tdemo\dose&
rr.obj c:\source\tdemo\cdrom.obj c:\source\tdemo\install.obj .AUTODEPEND
 @c:
 cd c:\source\tdemo
 @%write install.lk1 NAME install
 @%append install.lk1 FIL cdasm.obj,doserr.obj,cdrom.obj,install.obj
 @%append install.lk1 
 *wlink SYS dos4g op m op maxe=25 op q op symf @install.lk1
 copy c:\source\tdemo\install.exe c:\
 
 

