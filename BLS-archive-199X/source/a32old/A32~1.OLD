//list of all objects
object *o=0;

//object that is being edited
//objectdef *o=0; //not editing one yet
object    *p=0; //current object being edited (none)
object    pshadow(0,0,0,0,0); //shadow of p

int emode=0;
int playing=0; //if we are playing it
int playrepeat=0;

image *dragimg=0;
