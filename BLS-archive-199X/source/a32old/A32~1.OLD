char key=0;

int verbose=0;

int gshakedur=0;
int gshake[8]={0,1*320,3*320,2*320,-1*320,-4*320,-2*320,0};

char msg[100];
int msgdur=0;
int drawstat=1;

//control function names
char cfuncnames[256][32];
int cfuncnum;

//object definitions
int numodf=0;
