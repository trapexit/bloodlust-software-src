#define KSTAT *((unsigned char *)0x417)

char errstr[80];
void cleanexit(int x)
{
TerminateTimers();    
ModeText();    
if (x<0) printf("ERROR: %s\n",errstr);
exit(x);
}


volumefile v;

//Sound stuff
